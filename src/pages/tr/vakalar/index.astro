---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import { routePath } from '../../../i18n/routes';
import { PUBLISHED_CASES } from '../../../data/cases';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);
const base = p('cases');

const faq = [
  {
    q: 'Neden müşteri isimleri yazmıyorsunuz?',
    a: 'Bir müşterinin aldığı hizmeti ve içinde bulunduğu durumu kamuya açık yazmak, o müşterinin kararı olmalı. İzin aldığımız vakalarda ismi ekliyoruz; almadığımız sürece sektör ve şehirle anlatıyoruz. Ana sayfadaki logo şeridinde çalıştığımız işletmeler zaten görünüyor.',
  },
  {
    q: 'Neden sayısal sonuç paylaşmıyorsunuz?',
    a: 'Paylaşacağımız her rakamın ölçülmüş ve doğrulanabilir olması gerekiyor. Yerel sıralama arayanın konumuna göre değiştiği için tek bir "3. sıradan 1. sıraya" cümlesi zaten anlamsız. Ölçülmüş grid verisi eklendikçe bu sayfalara sayısal karşılaştırma da girecek.',
  },
  {
    q: 'Benim sektörümde vaka yok, işe yarar mı?',
    a: 'Vakaların anlatmaya çalıştığı şey sektör değil yöntem: sorunun nasıl teşhis edildiği ve hangi sırayla müdahale edildiği. Sektöre özgü farkları ayrıca sektör sayfalarında anlatıyoruz.',
  },
];
---

<ContentLayout
  locale={locale}
  route="cases"
  title="Vaka Çalışmaları | Akincy"
  description="Gerçek yerel SEO çalışmalarında sorunun nasıl teşhis edildiği ve hangi sırayla müdahale edildiği. Sektör ve şehir bazında, anonim."
  eyebrow="Vakalar"
  h1="Vaka Çalışmaları"
  lede="Aşağıdaki vakalar gerçek çalışmalardan. Müşteri isimleri, izin alınmadığı sürece paylaşılmıyor; anlatılan şey yapılan iş ve sorunun nasıl teşhis edildiği."
  serviceName="Yerel SEO Vaka Çalışmaları"
  breadcrumb={[{ label: 'Ana Sayfa', href: '/tr' }]}
  faq={faq}
  wideFirst
  related={[
    { label: 'Tüm hizmetler', href: p('services') },
    { label: 'Sektörlere göre yerel SEO', href: p('industries') },
    { label: 'Ücretsiz profil denetimi', href: p('tools/gbp-audit') },
  ]}
  ctaLabel="Ücretsiz Analizimi Al →"
  ctaHref="/tr#contact"
>
  <h2 id="nasil">Bu sayfalarda ne bulacaksınız?</h2>

  <p>
    Ajans vaka çalışmalarının çoğu sonucu anlatır: şu sıradan bu sıraya çıktık, şu kadar lead
    geldi. Bu sayfalarda bulacağınız şey bunun yerine <strong>teşhis</strong>: sorunun ne
    olduğu, nasıl anlaşıldığı ve hangi sırayla müdahale edildiği.
  </p>

  <p>
    Sebebi basit. Sonuç rakamı sizin işletmeniz için tekrarlanabilir bir bilgi değil —
    rekabetiniz, şehriniz ve başlangıç noktanız farklı. Tekrarlanabilir olan şey yöntem: hangi
    sinyale önce bakıldığı, hangi ölçümün neyi söylediği ve neyin boşa efor olduğu.
  </p>

  <div class="callout">
    <p>
      <strong>Neden sayısal karşılaştırma yok?</strong> Çünkü paylaşacağımız her rakamın
      ölçülmüş olması gerekiyor. Yerel sıralama arayanın konumuna göre değiştiği için tek bir
      sıralama cümlesi zaten yanıltıcı; anlamlı olan
      <a href={p('services/rank-tracking')}>grid ölçümü</a>. Ölçülmüş veri biriktikçe bu
      sayfalara sayısal karşılaştırma da eklenecek.
    </p>
  </div>

  <Fragment slot="wide">
    <h2 id="vakalar" class="section-lead">Vakalar</h2>
    <p class="section-lead-sub">
      Sektör ve şehir bazında, müşteri ismi olmadan.
    </p>

    <div class="service-grid">
      {PUBLISHED_CASES.map((c) => (
        <a class="card service-card case-card" href={`${base}/${c.slug}`}>
          <span class="case-card-meta">{c.sector} · {c.city}</span>
          <h3>{c.subject}</h3>
          <p>{c.summary}</p>
          <span class="service-card-more">Vakayı oku<span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </Fragment>

  <Fragment slot="cta">
    <h2>Sizin durumunuzda sorun <span class="highlight">nerede</span>?</h2>
    <p>Ücretsiz analizde profilinizi, sitenizi ve grid sıralamanızı çıkarıp teşhisi yapıyoruz.</p>
  </Fragment>
</ContentLayout>
